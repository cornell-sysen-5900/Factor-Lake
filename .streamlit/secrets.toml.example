# Streamlit Secrets Configuration Template
# Copy this file to secrets.toml and fill in your actual values
# NEVER commit secrets.toml to git - it's in .gitignore

# ===========================================
# MARKET DATA IN AWS S3 (default data source)
# ===========================================
# Read access to s3://sysen-5900-factor-lake/factor-lake-data/ is enough.
# See DOCS/AWS_S3_DATA.md
AWS_ACCESS_KEY_ID = "your-access-key-id"
AWS_SECRET_ACCESS_KEY = "your-secret-access-key"
AWS_DEFAULT_REGION = "us-east-1"
# FACTOR_LAKE_DATA_SOURCE = "s3"   # or "supabase" to use the fallback

# ===========================================
# SUPABASE DATABASE (fallback data source)
# ===========================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-anon-public-key-here"

# ===========================================
# DEPLOYMENT INSTRUCTIONS
# ===========================================
# For local development:
# 1. Copy this file: cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# 2. Edit .streamlit/secrets.toml with your actual values
# 3. Run: streamlit run app/streamlit_app.py
#
# For Streamlit Community Cloud:
# 1. Go to https://share.streamlit.io/
# 2. Connect your GitHub account
# 3. Deploy from cuddihyd-cornell/Factor-Lake (main branch)
# 4. In app settings > Secrets, paste the contents of your secrets.toml
# 5. Share the deployed URL with Cornell students (no password required)
